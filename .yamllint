---
extends: default

ignore:
  # mise が作成するローカル仮想環境(サードパーティのYAMLを含むため対象外)
  - .venv/

rules:
  # "---" ドキュメント開始マーカーの有無は統一していないため無効化
  document-start: disable
  # 秘密鍵/ハッシュ等、折り返せない長い1行の値を含むファイルがあるため緩和
  line-length:
    max: 200
  # Ansibleのloop等でよく使う "{ key: value }" 形式のインラインdictを許容
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  # 以下はansible-lintが要求する互換設定(合わせないとansible-lintが
  # このファイルを無視してしまう)
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
